# ========================================================
# NEXT Cultural War Room — Environment Configuration
# ========================================================

# Google Gemini API Key for Live AI specialist mesh & grounded search
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Primary Gemini Model for Specialist Agents (e.g. gemini-2.5-flash, gemini-3.7-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Arbiter Consensus Model (defaults to GEMINI_MODEL)
GEMINI_ARBITER_MODEL=gemini-2.5-flash

# API Rate Limits (requests per minute and requests per day quota)
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250

# Live News & Market Intelligence Ingestion Cycle (in milliseconds, default: 600000 = 10 minutes)
NEWS_REFRESH_MS=600000

# Real-time Signal Emitter Interval (in milliseconds, default: 3000 = 3 seconds)
EMIT_INTERVAL_MS=3000

# Enable/Disable Google Search Grounding for Live Signal Ingestion (true/false, default: true)
ENABLE_SEARCH_GROUNDING=true

# Specialist Agent In-Memory & SQLite Cache Duration (in minutes, default: 360 = 6 hours)
CACHE_TTL_MINUTES=360

# Default Governance Operator Role (e.g., Brand Director, Category Lead, Marketing VP, Social Lead)
DEFAULT_OPERATOR_ROLE=Brand Director
